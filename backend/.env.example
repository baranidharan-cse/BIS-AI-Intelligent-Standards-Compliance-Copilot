# ─────────────────────────────────────────────────────────────────────────────
# Study Buddy — Environment Variable Reference
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Study Buddy
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./study_buddy.db

# PostgreSQL (production — uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/study_buddy

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "demo"    → no API calls, deterministic responses (default for dev)
# "watsonx" → real IBM watsonx.ai API (requires credentials below)
LLM_PROVIDER=demo

# ── IBM watsonx.ai credentials ────────────────────────────────────────────────
# Required only when LLM_PROVIDER=watsonx.
# Get these from https://cloud.ibm.com/iam/apikeys and your watsonx project.
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── CORS ──────────────────────────────────────────────────────────────────────
# The origin of the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
