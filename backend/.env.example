# ═══════════════════════════════════════════════════════════════
#  Study Buddy — Environment Variables Reference
#
#  Copy this file to .env and fill in your values.
#  The defaults below work out of the box in demo mode.
#  NEVER commit .env to version control — it is gitignored.
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
APP_NAME="Study Buddy"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
# SQLite (default — zero setup, works immediately)
DATABASE_URL=sqlite+aiosqlite:///./study_buddy.db

# PostgreSQL (production — uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/studybuddy

# ── LLM Provider ─────────────────────────────────────────────
# "demo"    → DemoLLMService: no credentials needed, realistic mock
#             responses for all 5 LLM operations. Full demo works offline.
# "watsonx" → WatsonxLLMService: real IBM watsonx.ai calls.
#             Requires credentials below. Install: pip install ibm-watsonx-ai>=1.0.0
LLM_PROVIDER=demo

# ── IBM watsonx.ai Credentials ───────────────────────────────
# Required only when LLM_PROVIDER=watsonx.
# Get these from: https://cloud.ibm.com → watsonx.ai → Your Project → Manage
#
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
#
# Available foundation models (set one):
#   ibm/granite-13b-instruct-v2   (default — fast, instruction-tuned)
#   ibm/granite-20b-instruct-v2   (higher quality, slower)
#   meta-llama/llama-3-70b-instruct (if enabled in your project)
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── CORS ─────────────────────────────────────────────────────
# The origin of the frontend dev server. Must match exactly.
FRONTEND_ORIGIN=http://localhost:5173
